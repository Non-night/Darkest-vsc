_valid|can_crit_heal|is_targetable|target_allies|poison_resist|debuff_resist|target_damage|can_be_missed|on_change_sfx|monster_class|prefers_front|enter_effects|ignore_guard|bleed_resist|can_surprise|wave_effects|valid_modes|targchestfx|has_crit_vo|target_rank|stun_resist|move_resist|trap_resist|card_chance|enabled_dlc|targheadfx|misstargfx|base_class|can_be_hit|death_blow|animation|prefskill|intensity|can_miss|hp_ratio|is_under|reset_hp|hero_tag|effects|deathfx|fx_name|disease|launch|target|effect|targfx|isFlat|offset|poison|debuff|amount|level|count|class|buffs|bleed|index|move|crit|type|heal|icon|anim|size|prot|code|name|stun|trap|dmg|atk|def|nil|spd|min|max|id|fx|hp)\\b"
        }
      ]
    },
    "dynamic": {
      "patterns": [
        {
          "name": "keyword.other.info.darkest",
          "match": "\\.[A-Za-z0-9_]+_effects\\b"
        }
      ]
    },
    "invalid": {
      "patterns": [
        {
          "name": "invalid.illegal.darkest",
          "match": "\\.[A-Za-z0-9_]+"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.darkest",
          "match": "\"(?:(?!//)[^\"\\r\\n])*\""
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.darkest",
          "match": "\\b(?:true|false|True|False|TRUE|FALSE)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.darkest",
          "match": "-?\\b\\d+(?:\\.\\d+)?%?\\b"
        }
      ]
    },
    "unquoted": {
      "patterns": [
        {
          "name": "entity.name.tag.unquoted.darkest",
          "match": "\\b(?!(?:true|false|True|False|TRUE|FALSE)\\b)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
