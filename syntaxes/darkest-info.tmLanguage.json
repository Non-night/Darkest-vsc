{
  "scopeName": "source.darkest.info",
  "name": "Darkest Info",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#header"
    },
    {
      "include": "#known"
    },
    {
      "include": "#dynamic"
    },
    {
      "include": "#invalid"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#unquoted"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.darkest",
          "match": "//.*$"
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "name": "keyword.control.header.info.darkest",
          "match": "^[ \\t]*[A-Za-z0-9_]+:"
        }
      ]
    },
    "known": {
      "patterns": [
        {
          "name": "keyword.other.info.darkest",
          "match": "\\.(?:disable_additional_mash_for_infestation_sequence_on_death|is_monster_rerank_valid_on_friendly_presentation_end|is_monster_rerank_valid_on_friendly_post_result|does_count_as_monster_size_for_monster_brain|reduce_number_of_cards_in_deck_hero_class_id|can_display_performer_selection_after_turn|does_count_as_guardable_for_monster_brain|disabled_act_out_combat_start_turn_types|number_of_class_specific_camping_skills|reduce_number_of_cards_in_deck_amount|performing_monster_captor_base_class|can_relieve_stress_from_killing_blow|number_of_selected_combat_skills_max|override_stress_removal_amount_high|condensed_tooltip_effects_per_line|release_on_prisoner_at_deaths_door|override_stress_removal_amount_low|is_monster_rerank_valid_on_attack|always_guard_actor_base_class_ids|was_killed_other_monsters_effects|does_count_towards_stall_penalty|battle_complete_combat_skill_id|number_of_shared_camping_skills|release_on_prisoner_affliction|number_of_random_combat_skills|use_centre_skill_announcement|sort_position_z_rank_override|use_previous_monster_class_hp|living_hero_buff_instance_ids|clear_monster_brain_cooldowns|was_killed_all_heroes_effects|number_of_positive_quirks_min|number_of_positive_quirks_max|number_of_negative_quirks_min|number_of_negative_quirks_max|can_relieve_stress_from_crit|random_monster_class_chances|required_performer_hp_range|recovery_heart_attack_buffs|enter_effect_round_cooldown|override_trait_type_chances|override_valid_activity_ids|attack_friendly_targchestfx|damage_heal_base_class_ids|custom_idle_round_duration|affliction_combat_skill_id|raid_finish_quirk_class_id|captor_empty_monster_class|stress_per_controlled_turn|was_killed_by_hero_effects|disabled_popup_text_types|condensed_tooltip_effects|is_valid_trinket_attacker|number_of_turns_per_round|captor_full_monster_class|monster_class_valid_ranks|carry_over_hp_min_percent|was_hit_performer_effects|ambience_parameter_values|is_user_selected_targets|count_captor_full_damage|accelerat