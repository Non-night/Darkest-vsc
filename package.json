{
  "name": "darkest-dungeon",
  "displayName": "Darkest Dungeon Modding Support",
  "description": "Language support for Darkest Dungeon .darkest mod files: syntax highlighting, completion, diagnostics, comments, and RGBA color previews.",
  "version": "3.1.3",
  "publisher": "Nonight",
  "author": {
    "name": "Non-night",
    "url": "https://github.com/Non-night"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Non-night/Darkest-vsc.git"
  },
  "homepage": "https://github.com/Non-night/Darkest-vsc#readme",
  "bugs": {
    "url": "https://github.com/Non-night/Darkest-vsc/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#171419",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "darkest-dungeon",
    "darkest",
    "modding",
    "darkest-file",
    "syntax-highlighting",
    "autocomplete",
    "diagnostics",
    "linting"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:darkest-effect",
    "onLanguage:darkest-info",
    "onLanguage:darkest-art",
    "onLanguage:darkest-override",
    "onLanguage:darkest-colours",
    "onCommand:darkestDungeon.toggleLineComment",
    "onCommand:darkestDungeon.refreshDiagnostics"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "darkest-effect",
        "aliases": [
          "Darkest Effect",
          "darkest-effect"
        ],
        "extensions": [
          ".effects.darkest"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "darkest-info",
        "aliases": [
          "Darkest Info",
          "darkest-info"
        ],
        "extensions": [
          ".info.darkest"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "darkest-art",
        "aliases": [
          "Darkest Art",
          "darkest-art"
        ],
        "extensions": [
          ".art.darkest"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "darkest-override",
        "aliases": [
          "Darkest Override",
          "darkest-override"
        ],
        "extensions": [
          ".override.darkest"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "darkest-colours",
        "aliases": [
          "Darkest Colours",
          "darkest-colours"
        ],
        "extensions": [
          ".colours.darkest"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "darkest-effect",
        "scopeName": "source.darkest.effect",
        "path": "./syntaxes/darkest-effect.tmLanguage.json"
      },
      {
        "language": "darkest-info",
        "scopeName": "source.darkest.info",
        "path": "./syntaxes/darkest-info.tmLanguage.json"
      },
      {
        "language": "darkest-art",
        "scopeName": "source.darkest.art",
        "path": "./syntaxes/darkest-art.tmLanguage.json"
      },
      {
        "language": "darkest-override",
        "scopeName": "source.darkest.override",
        "path": "./syntaxes/darkest-override.tmLanguage.json"
      },
      {
        "language": "darkest-colours",
        "scopeName": "source.darkest.colours",
        "path": "./syntaxes/darkest-colours.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "darkestDungeon.toggleLineComment",
        "title": "Darkest Dungeon: 切换行注释"
      },
      {
        "command": "darkestDungeon.refreshDiagnostics",
        "title": "Darkest Dungeon: 刷新诊断"
      }
    ],
    "keybindings": [
      {
        "command": "darkestDungeon.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && (editorLangId == darkest-effect || editorLangId == darkest-info || editorLangId == darkest-art || editorLangId == darkest-override || editorLangId == darkest-colours)"
      }
    ],
    "configuration": {
      "title": "Darkest Dungeon",
      "properties": {
        "darkestDungeon.enableCtrlSlashToggleComment": {
          "type": "boolean",
          "default": true,
          "description": "启用 Darkest Dungeon 文件中的 Ctrl+/ 批量注释切换。"
        },
        "darkestDungeon.colours.enableAutomaticColorPreview": {
          "type": "boolean",
          "default": true,
          "description": "在 .colours.darkest 的 .rgba 参数旁显示颜色预览。"
        },
        "darkestDungeon.colours.enableColorPickerOnClick": {
          "type": "boolean",
          "default": true,
          "description": "允许通过颜色预览打开 VS Code 原生颜色选择器并写回 #RRGGBB。"
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.control.header.darkest",
              "keyword.control.header.info.darkest"
            ],
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.other.info.darkest",
            "settings": {
              "foreground": "#86A8C6"
            }
          },
          {
            "scope": "keyword.other.bleed.darkest",
            "settings": {
              "foreground": "#B10000"
            }
          },
          {
            "scope": "keyword.other.poison.darkest",
            "settings": {
              "foreground": "#BDC241"
            }
          },
          {
            "scope": "keyword.other.heal.darkest",
            "settings": {
              "foreground": "#87C241"
            }
          },
          {
            "scope": "keyword.other.stun.darkest",
            "settings": {
              "foreground": "#C99C45"
            }
          },
          {
            "scope": "keyword.other.kill.darkest",
            "settings": {
              "foreground": "#FF0000"
            }
          },
          {
            "scope": "keyword.other.riposte.darkest",
            "settings": {
              "foreground": "#C3630F"
            }
          },
          {
            "scope": "keyword.other.buff.darkest",
            "settings": {
              "foreground": "#5EC9D6"
            }
          },
          {
            "scope": "keyword.other.summon.darkest",
            "settings": {
              "foreground": "#7FFFD4"
            }
          }
        ],
        "[Default Dark Modern][Dark Modern][Dark+ (default dark)][Visual Studio Dark]": {
          "textMateRules": [
            {
              "scope": [
                "keyword.control.header.darkest",
                "keyword.control.header.info.darkest"
              ],
              "settings": {
                "foreground": "#C7A86B",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "keyword.control.core.darkest",
              "settings": {
                "foreground": "#A99CC4"
              }
            },
            {
              "scope": "variable.parameter.prop.darkest",
              "settings": {
                "foreground": "#9EA7B3"
              }
            },
            {
              "scope": "constant.numeric.darkest",
              "settings": {
                "foreground": "#C9A26D"
              }
            },
            {
              "scope": "entity.name.tag.unquoted.darkest",
              "settings": {
                "foreground": "#B6BCC8"
              }
            },
            {
              "scope": "keyword.other.info.darkest",
              "settings": {
                "foreground": "#86A8C6"
              }
            },
            {
              "scope": "invalid.illegal.darkest",
              "settings": {
                "foreground": "#D6B56C"
              }
            }
          ]
        },
        "[Default Light Modern][Light Modern][Light+ (default light)][Visual Studio Light][Quiet Light]": {
          "textMateRules": [
            {
              "scope": [
                "keyword.control.header.darkest",
                "keyword.control.header.info.darkest"
              ],
              "settings": {
                "foreground": "#7A5F22",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "keyword.control.core.darkest",
              "settings": {
                "foreground": "#694B7C"
              }
            },
            {
              "scope": "variable.parameter.prop.darkest",
              "settings": {
                "foreground": "#4F5B66"
              }
            },
            {
              "scope": "constant.numeric.darkest",
              "settings": {
                "foreground": "#815B21"
              }
            },
            {
              "scope": "entity.name.tag.unquoted.darkest",
              "settings": {
                "foreground": "#455B6D"
              }
            },
            {
              "scope": "keyword.other.info.darkest",
              "settings": {
                "foreground": "#315F85"
              }
            },
            {
              "scope": "invalid.illegal.darkest",
              "settings": {
                "foreground": "#8A6A1E"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run.js"
  }
}
